<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.sniffer" name="Video Sniffer" version="1.0.0" provider-name="Manus AI">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">A video sniffer addon like Video DownloadHelper.</summary>
        <description lang="en_GB">Sniff video URLs from web pages and play them in KODI with multiple resolutions and thumbnails.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
